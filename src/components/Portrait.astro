---
// Shows src/assets/portrait.(jpg|jpeg|png|webp) if it exists.
// Astro re-encodes it to a small WebP at build time, which also strips
// location and camera data. The original file is never published.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../site';

const found = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.values(found)[0]?.default;
---

<figure class="snapshot">
  <span class="tape" aria-hidden="true"></span>
  {
    photo ? (
      <Image
        src={photo}
        alt="Portrait photo"
        width={360}
        format="webp"
        quality={72}
        loading="eager"
        draggable="false"
        class="photo"
      />
    ) : (
      <div class="placeholder" role="img" aria-label="Photo placeholder">
        <span>Add src/assets/portrait.jpg</span>
      </div>
    )
  }
  {site.photoCaption && <figcaption>{site.photoCaption}</figcaption>}
</figure>

<style>
  .snapshot {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 13rem;
    padding: 0.6rem 0.6rem 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    transform: rotate(-2.5deg);
  }
  .tape {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 5rem;
    height: 1.4rem;
    background: var(--tape);
    transform: translateX(-50%) rotate(3deg);
  }
  .photo,
  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    border: 1.5px dashed var(--ink-faint);
    color: var(--ink-faint);
    font-size: 0.8rem;
    text-align: center;
    padding: 1rem;
  }
  figcaption {
    margin-top: 0.55rem;
    font-family: var(--hand);
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--pen);
    text-align: center;
  }
</style>
