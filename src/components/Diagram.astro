---
// Inlines an SVG from src/diagrams/ so it follows light and dark mode.
// Diagram SVGs use these classes: box, box-mine, line, dash, label, sub, group.
interface Props {
  name: string;
  alt: string;
}
const { name, alt } = Astro.props;
const files = import.meta.glob<string>('../diagrams/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const svg = files[`../diagrams/${name}`];
if (!svg) throw new Error(`Diagram not found: src/diagrams/${name}`);
const labelled = svg.replace('<svg', `<svg role="img" aria-label="${alt.replace(/"/g, '&quot;')}"`);
---

<figure class="diagram">
  <div class="diagram-scroll" set:html={labelled} />
  <figcaption class="scroll-hint">Scroll sideways to see the whole diagram.</figcaption>
</figure>

<style>
  .diagram {
    margin: 2rem 0 2.25rem;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-raised);
  }
  .diagram-scroll {
    overflow-x: auto;
  }
  .scroll-hint {
    display: none;
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  @media (max-width: 40rem) {
    .scroll-hint {
      display: block;
    }
  }
  @media (min-width: 62rem) {
    .diagram {
      width: calc(var(--measure) + var(--gutter) + var(--margin-col));
      padding: 1.5rem 1.75rem;
    }
  }
  .diagram-scroll :global(svg) {
    min-width: 34rem;
    width: 100%;
    font-family: var(--sans);
  }
  .diagram :global(.box) {
    fill: var(--paper-raised);
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .diagram :global(.box-mine) {
    fill: var(--highlight);
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .diagram :global(.group) {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .diagram :global(.line) {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.3;
  }
  .diagram :global(.dash) {
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.3;
    stroke-dasharray: 5 4;
  }
  .diagram :global(.arrow) {
    fill: var(--ink-soft);
  }
  .diagram :global(.arrow-pen) {
    fill: var(--pen);
  }
  .diagram :global(.label) {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 500;
  }
  .diagram :global(.sub) {
    fill: var(--ink-faint);
    font-size: 11.5px;
  }
  .diagram :global(.hand) {
    fill: var(--pen);
    font-family: var(--hand);
    font-size: 14px;
  }
</style>
