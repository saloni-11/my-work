---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const featured = (await getCollection('work', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base hideName>
  <section class="intro wrap">
    <div class="name-row">
      <h1>{site.name}</h1>
      <a class="pill" href="#contact">Get in touch</a>
    </div>
    <p class="bio">{site.statement}</p>
    <p class="where">{site.role}, {site.location}</p>
  </section>

  <section class="work wrap" aria-labelledby="work-heading">
    <h2 id="work-heading">My top work</h2>
    <ul class="cards">
      {featured.map((project, i) => <li><ProjectCard project={project} eager={i === 0} /></li>)}
    </ul>
  </section>

  <section class="experience wrap" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <ul class="rows">
      {
        site.experience.map((job) => (
          <li>
            <span class="when">{job.when}</span>
            <span class="what">{job.what}</span>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/about">More about me</a></p>
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>
    <p>Email is the best way to reach me.</p>
    <p class="email"><a href={`mailto:${site.links.email}`}>{site.links.email}</a></p>
    <ul class="links">
      <li><a href={site.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={site.links.github} rel="me">GitHub</a></li>
    </ul>
  </section>
</Base>

<style>
  .intro {
    padding-top: 1.5rem;
  }
  .name-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.25rem;
  }
  /* Same family as the bio so the intro reads as one piece. */
  h1 {
    font-family: var(--sans);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .pill {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    /* Keep the dark button when printed or saved as PDF. */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .pill:hover {
    background: var(--pen);
  }
  .bio {
    max-width: 38rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .where {
    font-size: 0.95rem;
    color: var(--ink-faint);
  }

  .work {
    margin-top: 6rem;
  }
  .work h2 {
    margin-bottom: 1.75rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* A hairline and generous space between projects, so each reads as its own piece. */
  .cards > li + li {
    margin-top: 4.5rem;
    padding-top: 4.5rem;
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 40rem) {
    .work {
      margin-top: 4rem;
    }
    .cards > li + li {
      margin-top: 3rem;
      padding-top: 3rem;
    }
  }

  /* Section labels: small and quiet, in the same family as the name. */
  h2 {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .experience {
    margin-top: 5rem;
  }
  .rows {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .rows li {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 0 1rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--rule);
  }
  .rows li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .when {
    color: var(--ink-faint);
  }
  .more {
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .contact {
    margin-top: 4rem;
  }
  .contact h2 {
    margin-bottom: 0.5rem;
  }
  .contact p {
    margin-bottom: 0.4rem;
    color: var(--ink-soft);
  }
  .email {
    font-family: var(--serif);
    font-size: 1.4rem;
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }

  @media (max-width: 40rem) {
    .rows li {
      grid-template-columns: 1fr;
    }
  }
</style>
