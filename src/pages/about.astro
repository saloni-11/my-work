---
import Base from '../layouts/Base.astro';
import { site } from '../site';

// Edit these lists to update the timeline.
const experience = [
  {
    when: 'Nov 2025 – now',
    what: 'Analyst Developer, LIXI',
    where: 'Sydney',
    note: 'Internship from Aug 2025, then full-time. RAG pipelines, agentic review workflows and developer tooling for Australia’s lending data standards.',
  },
  {
    when: 'Sep 2024 – Jul 2025',
    what: 'IT Business Analyst Intern, BallR Hub',
    where: 'Sydney',
    note: 'Mobile app testing, bug triage in Jira, and gap analysis for an early-stage sports-tech startup.',
  },
  {
    when: 'Mar 2024',
    what: 'AI Developer (contract), Upstride',
    where: 'Melbourne',
    note: 'Connected a client-facing CRM site to Google Cloud Spanner ahead of planned AI work.',
  },
  {
    when: 'Feb 2021 – Jan 2024',
    what: 'Software Developer, DbCom Systems Software',
    where: 'Belgaum, India',
    note: 'Started the company’s machine learning work from scratch: an anomaly detection model with per-prediction explanations for a US trade surveillance platform.',
  },
];

const education = [
  {
    when: '2024 – 2025',
    what: 'Master of IT (Data Analytics), University of Technology Sydney',
    note: 'WAM 90.38. Dean’s List 2025 and 2026.',
  },
  {
    when: '2017 – 2021',
    what: 'Bachelor of Engineering (Electronics and Communications), KLS Gogte Institute of Technology',
    note: 'CGPA 9.81/10, First Class with Distinction.',
  },
];
---

<Base title="About" description={`About ${site.name}, AI engineer in Sydney.`}>
  <section class="wrap about">
    <h1>About</h1>
    <div class="story">
      <p>
        I trained as an electronics engineer, where the habit that stuck was measuring a circuit
        before trusting it. I bring the same habit to AI systems: a model isn’t done until I know
        how it fails and someone can check its output.
      </p>
      <p>
        My first ML work started as an internship at DbCom, where I was the only developer
        figuring out where machine learning could help a trade surveillance product. I learned the
        fundamentals alongside the job, then went on to a Master’s in data analytics at UTS.
      </p>
      <p>
        Today I work at LIXI, the body that maintains the data standards Australian banks, brokers
        and lenders use to exchange loan information. I build RAG pipelines, review workflows and
        tools around those standards.
      </p>
      <p class="rights">{site.workRights}</p>
    </div>

    <h2>Experience</h2>
    <ol class="timeline">
      {
        experience.map((item) => (
          <li>
            <span class="when">{item.when}</span>
            <div>
              <h3>{item.what}</h3>
              <p class="where">{item.where}</p>
              <p>{item.note}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <h2>Education</h2>
    <ol class="timeline">
      {
        education.map((item) => (
          <li>
            <span class="when">{item.when}</span>
            <div>
              <h3>{item.what}</h3>
              <p>{item.note}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <h2>Get in touch</h2>
    <p class="contact">
      The best way to reach me is email: <a href={`mailto:${site.links.email}`}>{site.links.email}</a>.
      I’m also on <a href={site.links.linkedin} rel="me">LinkedIn</a> and
      <a href={site.links.github} rel="me">GitHub</a>.
    </p>
  </section>
</Base>

<style>
  .about {
    padding-top: 1.5rem;
  }
  .about > * {
    max-width: var(--measure);
  }
  h1 {
    font-size: clamp(2.3rem, 5vw, 3.2rem);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 1.6rem;
    margin: 3.5rem 0 1.25rem;
  }
  .story,
  .contact {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.65;
  }
  .rights {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
  }
  .when {
    font-size: 0.9rem;
    color: var(--ink-faint);
    padding-top: 0.2rem;
  }
  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }
  .where {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-bottom: 0.4rem;
  }
  .timeline p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (max-width: 36rem) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
