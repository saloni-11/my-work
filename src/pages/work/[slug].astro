---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Note from '../../components/Note.astro';
import Diagram from '../../components/Diagram.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const p = project.data;
if (!project.body?.includes('<Diagram')) {
  throw new Error(`${project.id}: add an architecture <Diagram name="..." alt="..." /> to the page.`);
}
const { Content } = await render(project);
---

<Base title={p.title} description={p.summary}>
  <article class="case wrap">
    <header class="case-head">
      <p class="crumb"><a href="/work">All projects</a></p>
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
      {
        p.status === 'in progress' && (
          <p class="status-note">
            I'm still improving this project, so the numbers below will change.
          </p>
        )
      }
      <dl class="facts">
        <div><dt>When</dt><dd>{p.period}</dd></div>
        <div><dt>Context</dt><dd>{p.context}</dd></div>
        <div><dt>My part</dt><dd>{p.role}</dd></div>
        <div><dt>Built with</dt><dd>{p.stack.join(', ')}</dd></div>
      </dl>
    </header>

    <div class="prose">
      <Content components={{ Note, Diagram }} />

      <h2>Results</h2>
      <div class="table-scroll">
        <table class="results">
          <thead>
            <tr><th scope="col">Measure</th><th scope="col">Result</th><th scope="col">Measured on</th></tr>
          </thead>
          <tbody>
            {
              p.metrics.map((m) => (
                <tr>
                  <th scope="row">{m.label}</th>
                  <td class="value"><mark>{m.value}</mark></td>
                  <td class="conditions">{m.conditions}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>What I'd do differently</h2>
      <ul class="lessons">
        {p.lessons.map((lesson) => <li>{lesson}</li>)}
      </ul>

      {
        p.links.length > 0 && (
          <p class="links">
            {p.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </p>
        )
      }
    </div>
  </article>
</Base>

<style>
  .case {
    padding-top: 1.5rem;
  }
  .case-head,
  .prose {
    max-width: var(--measure);
  }
  .crumb {
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(2.3rem, 5vw, 3.4rem);
    font-weight: 400;
    margin-bottom: 0.75rem;
  }
  .lede {
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .status-note {
    font-family: var(--hand);
    font-size: 1.15rem;
    color: var(--pen);
    transform: rotate(-1deg);
    transform-origin: left;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    margin: 2rem 0 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .facts dd {
    margin: 0.1rem 0 0;
    font-size: 0.98rem;
  }

  /* Long-form text inside the .mdx file */
  .prose {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.65;
  }
  .prose :global(h2) {
    font-size: 1.75rem;
    margin: 3rem 0 1rem;
    clear: both;
  }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 2rem 0 0.6rem;
  }
  .prose :global(ul) {
    padding-left: 1.2rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(li::marker) {
    color: var(--pen);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(code) {
    font-size: 0.85em;
    background: var(--rule);
    padding: 0.05em 0.3em;
    border-radius: 3px;
  }

  .table-scroll {
    overflow-x: auto;
  }
  .results {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 0.98rem;
  }
  .results th,
  .results td {
    text-align: left;
    vertical-align: top;
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .results thead th {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--ink-faint);
    border-bottom: 1.5px solid var(--ink);
  }
  .results tbody th {
    font-weight: 500;
  }
  .results .value {
    white-space: nowrap;
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  .results .conditions {
    color: var(--ink-soft);
  }
  .lessons li {
    margin-bottom: 0.75rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    font-family: var(--sans);
    font-size: 1rem;
  }
  @media (max-width: 36rem) {
    .facts {
      grid-template-columns: 1fr;
    }
    .prose {
      font-size: 1.1rem;
    }
  }
</style>
